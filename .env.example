# Server-only (Vercel Project Settings → Environment Variables).
# Do NOT use VITE_ prefix — that would expose the key in the browser bundle.
# Enable "YouTube Data API v3" in Google Cloud; prefer IP / none restriction for server keys
# (or restrict to your Vercel egress if you use a static outbound IP).
YOUTUBE_API_KEY=
# Nature Walk CSC channel id (starts with UC…)
YOUTUBE_CHANNEL_ID=

# Local tip: use `npx vercel dev` so /api/youtube-recordings is available.
# Plain `npm run dev` (Vite only) cannot serve the serverless function.
