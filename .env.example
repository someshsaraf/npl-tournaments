# Copy to .env and fill in. Read by the server (server/index.ts) at startup;
# never prefix these with VITE_ (that would ship them to browsers).

# ── Required ────────────────────────────────────────────────────────────────
# Signs login sessions and upload links. Generate: openssl rand -hex 32
AUTH_JWT_SECRET=
# Mixed into access-code hashes. Generate: openssl rand -hex 32
AUTH_PEPPER=
# Shared code residents and court screens enter once per device (6–64 chars,
# not case-sensitive). Staff can change it later from /admin/access.
COMMUNITY_ACCESS_CODE=
# Fixed staff code. Generate: node scripts/hash-admin-password.mjs --generate
# and paste the printed ADMIN_CODE_HASH line here, quotes included.
ADMIN_CODE_HASH=

# ── Server ──────────────────────────────────────────────────────────────────
# Public address of the site, used by deploy/ (Caddy HTTPS), e.g. rnw-sports.duckdns.org.
# Not needed for local development.
SITE_DOMAIN=
PORT=8787
# Where the SQLite database (app.db) and uploaded media live. Back this folder up.
DATA_DIR=./data
# Behind a reverse proxy that terminates HTTPS (Caddy, nginx, Traefik, a PaaS):
# TRUST_PROXY=true
# Force session cookies' Secure flag on/off (default: on when served over HTTPS).
# COOKIE_SECURE=true

# ── Media storage (photos, videos, score snapshots) ─────────────────────────
# local (default): files in DATA_DIR/media, served at /media/…
# s3: any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Backblaze B2…)
MEDIA_STORAGE=local
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public https base URL for the bucket, no trailing slash
# S3_PUBLIC_BASE_URL=
# (The older R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY /
#  R2_BUCKET_NAME / R2_PUBLIC_BASE_URL names are still accepted.)

# ── Optional features ───────────────────────────────────────────────────────
# Past live-stream recordings (YouTube Data API v3 key)
YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_ID=UCArjq0pgzz_DjtglfS6i_Fg
# Ask chatbot (Gemini). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
