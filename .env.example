# Server-only (Vercel Project Settings → Environment Variables).
# Do NOT use VITE_ prefix — that would expose secrets in the browser bundle.

YOUTUBE_API_KEY=

# Optional. Defaults to @NatureWalkCSC (UCArjq0pgzz_DjtglfS6i_Fg).
# YOUTUBE_CHANNEL_ID=UCArjq0pgzz_DjtglfS6i_Fg

# Gemini — Ask chatbot (/ask → POST /api/ask). Strict answers from tournament context only.
# Create a key: https://aistudio.google.com/apikey
# Production: Vercel → Project Settings → Environment Variables → GEMINI_API_KEY → Redeploy
# Local: copy this file to `.env`, set the key, then run `npm run dev:ask` (or `npx vercel dev`).
# Plain `npm run dev` (Vite only) cannot serve /api/ask — Ask will show Offline.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash

# Cloudflare R2 — community gallery uploads (/photos)
# Create bucket + API token (Object Read & Write) in Cloudflare dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL with no trailing slash, e.g. https://pub-xxxxx.r2.dev
# (enable "Public access" / r2.dev subdomain, or attach a custom domain)
R2_PUBLIC_BASE_URL=

# Local tip: use `npx vercel dev` so /api/* routes (Ask, YouTube, gallery) are available.
