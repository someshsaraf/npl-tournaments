rules_version = '2';

// Deploy with Firebase CLI against project npl-tournaments.
// Public gallery uploads: create/delete under gallery/{uploadId}/… with contentType limits.
// No per-file size cap — only the shared 5 GB quota (enforced client-side via RTDB).
// Score snapshots under photos/ remain as previously configured in the console.

service firebase.storage {
  match /b/{bucket}/o {
    function isGalleryImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isGalleryVideo() {
      return request.resource.contentType.matches('video/(mp4|webm)');
    }

    match /gallery/{uploadId}/{fileName} {
      allow read: if true;
      allow create: if uploadId.size() > 8
        && uploadId.size() < 64
        && !uploadId.matches('.*\\.\\..*')
        && (isGalleryImage() || isGalleryVideo());
      allow delete: if true;
      allow update: if false;
    }

    // Existing score snapshot uploads (adjust if your console rules differ).
    match /photos/{fileName} {
      allow read: if true;
      allow write: if request.resource.contentType == 'image/png'
        && request.resource.size < 8 * 1024 * 1024;
    }
  }
}
